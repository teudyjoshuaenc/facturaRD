{
  "name": "@facturard/api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main",
    "start:prod": "npx prisma migrate deploy --schema=packages/database/prisma/schema.prisma && node dist/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "test": "jest",
    "test:e2e:up": "docker compose -f test/docker-compose.test.yml up -d --wait",
    "test:e2e": "pnpm test:e2e:up && DATABASE_URL=postgresql://facturard:facturard_dev@localhost:5433/facturard_test NODE_ENV=test JWT_SECRET=facturard-jwt-secret-desarrollo-local-muy-largo-123456789 JWT_REFRESH_SECRET=facturard-refresh-secret-desarrollo-local-123456789 ENCRYPTION_KEY='facturard-encryption-32chars-dev!' REDIS_HOST=localhost REDIS_PORT=6379 jest --config ./test/jest-e2e.json --runInBand --forceExit"
  },
  "dependencies": {
    "@facturard/database": "workspace:*",
    "@facturard/ecf-engine": "workspace:*",
    "@facturard/shared": "workspace:*",
    "@nestjs/bull": "^10.2.3",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/swagger": "^8.1.1",
    "@prisma/client": "^6.1.0",
    "@sendgrid/mail": "^8.1.6",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.34.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "helmet": "^8.0.0",
    "ioredis": "^5.11.0",
    "multer": "^2.1.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@facturard/config": "workspace:*",
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.15",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.10.5",
    "@types/node-forge": "^1.3.11",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "node-forge": "^1.3.1",
    "prisma": "^6.1.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.7",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
