# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/facturard"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=change-me-in-production-use-32-chars-min
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-refresh-secret-in-production
JWT_REFRESH_EXPIRES_IN=7d

# App
PORT=3001
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000

# Cloudinary — subida REAL del logo del emisor (se sirve optimizado al PDF y la UI).
# Las tres son OBLIGATORIAS: sin ellas la API NO arranca (fail-fast, como ENCRYPTION_KEY).
# El api_secret es sensible: server-side únicamente, NUNCA se expone al frontend.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
