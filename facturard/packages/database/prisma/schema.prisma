generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Plan {
  BASICO
  PYME
  PRO
}

enum TenantEstado {
  ACTIVO
  SUSPENDIDO
  CANCELADO
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  USUARIO
  CONTADOR
}

enum TipoECF {
  E31
  E32
  E33
  E34
  E41
  E43
  E44
  E45
  E46
  E47
}

enum ComprobanteEstado {
  DRAFT
  PENDIENTE
  EN_COLA
  ENVIANDO
  ACEPTADO
  ACEPTADO_CONDICIONAL
  RECHAZADO
  ERROR
  // Documento interno "Nota de venta" (esFiscal=false): NO es un e-CF. Estado
  // terminal — nunca entra al ciclo DGII (sin e-NCF, sin firma, sin envío).
  INTERNO
}

// ─── Finanzas (módulo de flujo de caja — NO fiscal) ──────────────────────────
// Estas tablas son 100% lectura/registro contable interno. NUNCA participan del
// ciclo DGII: no consumen e-NCF, no firman, no tocan estados de comprobantes.

enum MovimientoTipo {
  INGRESO
  EGRESO
}

enum MovimientoCategoria {
  NOMINA
  ALQUILER
  SERVICIOS
  PRESTAMO
  APORTE_CAPITAL
  IMPUESTOS
  OTROS
}

enum PagoTipo {
  COBRO // entra dinero — sobre una factura (comprobante)
  PAGO  // sale dinero  — sobre una compra
}

enum CajaEstado {
  ABIERTA
  CERRADA
}

// Canales de entrega de un comprobante al cliente, vía GoHighLevel. WHATSAPP
// existe desde el día uno para no migrar el enum después, pero AÚN NO está
// implementado: la WhatsApp Business Platform exige plantillas aprobadas por
// Meta para mensajes iniciados por el negocio (fuera de la ventana de 24h),
// así que pedir este canal responde 400 "aún no disponible", nunca un envío.
enum CanalEnvio {
  EMAIL
  WHATSAPP
}

// OJO con la semántica: ENVIADO significa "GHL ACEPTÓ el mensaje y devolvió un
// messageId", NO "el cliente lo recibió". No modelamos estados de entrega
// (delivered/read): eso exigiría consumir webhooks de GHL. Si algún día se
// modelan, van como estados NUEVOS, sin cambiar el significado de estos dos.
enum EstadoEnvio {
  ENVIADO
  FALLIDO
}

// ─── Models ───────────────────────────────────────────────────────────────────

model Tenant {
  id              String       @id @default(uuid())
  rnc             String       @unique
  razonSocial     String
  nombreComercial String?
  direccion       String?
  // Datos de contacto del emisor que aparecen en la representación impresa
  // (PDF/cotización). Editables en Empresa; RNC/razonSocial NO (vienen de DGII).
  telefono        String?
  email           String?
  plan            Plan         @default(BASICO)
  estado          TenantEstado @default(ACTIVO)
  planActivo      Boolean      @default(true)
  trialEndsAt     DateTime?
  // Config GHL para sincronización de contactos (Sprint 3).
  // ghlAccessToken cifrado AES-256-GCM (formato iv:tag:data en base64).
  ghlAccessToken  String?
  ghlRncFieldKey  String?
  // Branding para la representación impresa (Sprint 6).
  // logoUrl: URL http(s) pública del logo. Puede ser (a) un enlace externo pegado
  // por el usuario o (b) la secure URL de Cloudinary (derivada f_png) tras subir un
  // archivo. logoPublicId sólo se setea en el caso (b) — es el public_id fijo
  // `facturard/<tenantId>/logo` que permite reemplazar sin huérfanos y derivar la
  // variante f_auto para la UI. Escribir un logoUrl manual limpia logoPublicId.
  logoUrl         String?
  logoPublicId    String?
  colorPrimario   String?
  colorSecundario String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  users                User[]
  comprobantes         Comprobante[]
  certificados         Certificado[]
  apiKeys              ApiKey[]
  webhooks             Webhook[]
  auditLogs            AuditLog[]
  secuencias           Secuencia[]
  comprobantesRecibidos ComprobanteRecibido[]
  ghlLocations         GhlLocation[]
  productos            Producto[]
  contactos            Contacto[]
  cotizaciones         Cotizacion[]
  comprasRecibidas     CompraRecibida[]
  movimientos          MovimientoFinanciero[]
  pagos                Pago[]
  capitalInicial       CapitalInicial?
  presupuestoConfig    PresupuestoConfig?
  cajaDiaria           CajaDiaria[]
  enviosComprobante    EnvioComprobante[]

  @@map("tenants")
}

model CompraRecibida {
  id                   String    @id @default(uuid())
  tenantId             String
  contactoId           String?   // proveedor (Contacto tipo PROVEEDOR)
  tipo                 String    // "E41" | "GASTO_MENOR" | "SIN_COMPROBANTE" | "RECIBIDO_ECF"
  ncf                  String?   // NCF/e-NCF del proveedor
  rncProveedor         String?
  razonSocialProveedor String?
  fechaComprobante     DateTime?
  subtotal             Decimal   @db.Decimal(18, 2)
  itbis                Decimal   @db.Decimal(18, 2)
  itbisRetenido        Decimal   @db.Decimal(18, 2) @default(0)
  total                Decimal   @db.Decimal(18, 2)
  estadoAprobacion     String?   // e-CF recibido: APROBADO|RECHAZADO|PENDIENTE
  origen               String    @default("MANUAL") // MANUAL|RECEPCION_DGII
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  pagos  Pago[] // relación virtual — no agrega columnas a esta tabla fiscal

  @@index([tenantId, fechaComprobante])
  @@map("compras_recibidas")
}

model Cotizacion {
  id            String   @id @default(uuid())
  tenantId      String
  folio         String   // interno, p.ej. COT-000123 (NO es e-NCF, nunca va a la DGII)
  contactoId    String?
  estado        String   @default("BORRADOR") // BORRADOR|ENVIADA|APROBADA|RECHAZADA|VENCIDA|CONVERTIDA
  fechaVigencia DateTime?
  subtotal      Decimal  @db.Decimal(18, 2)
  itbis         Decimal  @db.Decimal(18, 2)
  total         Decimal  @db.Decimal(18, 2)
  comprobanteId String?  // seteado al convertir
  notas         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant Tenant           @relation(fields: [tenantId], references: [id])
  items  CotizacionItem[]

  @@unique([tenantId, folio])
  @@index([tenantId, estado])
  @@map("cotizaciones")
}

model CotizacionItem {
  id               String   @id @default(uuid())
  cotizacionId     String
  productoId       String?
  nombre           String
  descripcion      String?
  cantidad             Decimal @db.Decimal(18, 3)
  precioUnitario       Decimal @db.Decimal(18, 2)
  tratamientoITBIS     String
  indicadorBienoServicio String @default("2") // "1"=Bien, "2"=Servicio
  unidadMedida         String?

  cotizacion Cotizacion @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)

  @@map("cotizacion_items")
}

// Contador atómico de folios por tenant (mismo patrón de incremento que las
// secuencias e-NCF). El INSERT ... ON CONFLICT DO NOTHING crea la fila sin
// condición de carrera y el UPDATE ... += 1 serializa por lock de fila.
model CotizacionFolio {
  tenantId    String   @id
  ultimoFolio Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@map("cotizacion_folios")
}

// Contador atómico de folios de Notas de venta internas (NV-000001) por tenant.
// Mismo patrón que CotizacionFolio: independiente de las secuencias e-NCF.
model DocumentoFolio {
  tenantId    String   @id
  ultimoFolio Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@map("documento_folios")
}

model Contacto {
  id                      String   @id @default(uuid())
  tenantId                String
  tipo                    String   // CLIENTE|PROVEEDOR|CONSUMIDOR_FINAL
  rnc                     String?
  razonSocial             String
  nombreComercial         String?
  identificadorExtranjero String?
  paisExtranjero          String?
  direccion               String?
  provincia               String?
  municipio               String?
  telefono                String?
  email                   String?
  origen                  String   @default("MANUAL") // MANUAL|GHL
  ghlContactId            String?
  rncValidado             Boolean  @default(false)
  activo                  Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, rnc])
  @@unique([tenantId, ghlContactId])
  @@index([tenantId, tipo, activo])
  @@index([tenantId, provincia])
  @@map("contactos")
}

model Producto {
  id               String   @id @default(uuid())
  tenantId         String
  tipo             String   // "BIEN" | "SERVICIO"
  nombre           String
  descripcion      String?
  precioUnitario   Decimal  @db.Decimal(18, 2)
  tratamientoITBIS String   @default("I1") // I1|I2|I3|EXENTO
  unidadMedida     String?  // codificación DGII
  codigo           String?
  categoria        String?
  activo           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, codigo])
  @@index([tenantId, activo])
  @@map("productos")
}

model User {
  id                String   @id @default(uuid())
  tenantId          String
  email             String
  passwordHash      String
  nombre            String
  role              UserRole @default(USUARIO)
  activo                Boolean   @default(true)
  refreshTokenHash      String?
  resetPasswordToken    String?
  resetPasswordExpires  DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  auditLogs AuditLog[]

  @@unique([tenantId, email])
  @@map("users")
}

model Certificado {
  id                String   @id @default(uuid())
  tenantId          String
  // Metadatos del certificado (nunca el P12 en plano)
  titular           String
  rnc               String
  serial            String
  emitidoPor        String
  validoDesde       DateTime
  validoHasta       DateTime

  // P12 cifrado con AES-256-GCM (nunca se devuelve al cliente)
  p12Encrypted      String    // base64 del buffer cifrado
  p12Iv             String    // hex del IV
  p12Tag            String    // hex del auth tag GCM

  // Passphrase cifrada — formato base64(iv):base64(tag):base64(encrypted)
  passphraseCifrada String

  activo            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, activo])
  @@map("certificados")
}

model Comprobante {
  id           String            @id @default(uuid())
  tenantId     String
  // eNCF es nullable: los borradores (estado DRAFT) aún no consumen secuencia.
  // El e-NCF se asigna atómicamente sólo al emitir. NULLs son distintos en el
  // índice único de Postgres, así que múltiples borradores conviven sin colisión.
  eNCF         String?
  // Discriminador fiscal. true (default) = e-CF fiscal → mismo ciclo DGII de
  // siempre (DMAIA intacto). false = "Nota de venta" interna: sin e-NCF, sin
  // firma, sin DGII, sin reportes 606/607/608. NULLs/default mantienen todas
  // las filas existentes como fiscales.
  esFiscal     Boolean           @default(true)
  // Número interno de la Nota de venta (NV-000001). Sólo para esFiscal=false;
  // null en fiscales (que usan eNCF). Nunca es un e-NCF ni va a la DGII.
  folioInterno String?
  // Soft delete: sólo las Notas de venta (esFiscal=false) son eliminables. Un
  // e-CF fiscal emitido es inmutable y nunca se marca aquí.
  eliminado    Boolean           @default(false)
  tipoECF      TipoECF
  estado       ComprobanteEstado @default(PENDIENTE)
  xmlFirmado   String?
  trackId      String?
  mensajeDGII  String?
  montoTotal   Decimal           @db.Decimal(18, 2)
  rnc          String            // RNC del comprador
  razonSocial  String            // Razón social del comprador
  pdfUrl       String?
  intentos     Int               @default(0)
  datos        Json?             // DTO original para el worker
  // Referencias (nullable). Las relaciones a Contacto/Cotizacion se agregan en
  // sprints posteriores; por ahora se persisten como columnas sueltas.
  contactoId              String?
  cotizacionId            String?
  comprobanteReferenciaId String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  pagos  Pago[] // relación virtual — no agrega columnas a esta tabla fiscal
  envios EnvioComprobante[] // ídem: entregas al cliente (post-emisión, no fiscal)

  @@unique([tenantId, eNCF])
  @@unique([tenantId, folioInterno])
  @@index([tenantId, estado])
  @@index([tenantId, createdAt])
  @@index([tenantId, esFiscal])
  @@map("comprobantes")
}

model ApiKey {
  id        String    @id @default(uuid())
  tenantId  String
  nombre    String
  keyHash   String    @unique
  ultimoUso DateTime?
  activo    Boolean   @default(true)
  createdAt DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("api_keys")
}

model Webhook {
  id          String   @id @default(uuid())
  tenantId    String
  url         String
  secretoHMAC String
  eventos     String[]
  tipo        String   @default("SALIENTE") // "GHL_ENTRADA" | "SALIENTE"
  nombre      String?
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("webhooks")
}

model AuditLog {
  id        String   @id @default(uuid())
  tenantId  String
  userId    String?
  accion    String
  entidad   String
  entidadId String?
  detalle   Json?
  ip        String?
  createdAt DateTime @default(now())

  tenant Tenant  @relation(fields: [tenantId], references: [id])
  user   User?   @relation(fields: [userId], references: [id])

  @@index([tenantId, createdAt])
  @@index([tenantId, accion])
  @@map("audit_logs")
}

model ComprobanteRecibido {
  id             String   @id @default(uuid())
  tenantId       String   // tenant receptor (nuestro RNC)
  rncEmisor      String   // RNC del emisor que nos envía el e-CF
  eNCF           String   // número de e-CF
  tipoECF        String   // "31", "32", etc.
  xmlFirmado     String   // XML completo del e-CF recibido
  estado         String   @default("RECIBIDO") // RECIBIDO | ACEPTADO | RECHAZADO
  aprobacion     String?  // XML de aprobación comercial (ACECF)
  fechaRecepcion DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, eNCF, rncEmisor])
  @@index([tenantId, rncEmisor])
  @@index([tenantId, fechaRecepcion])
  @@map("comprobantes_recibidos")
}

model GhlLocation {
  id         String   @id @default(uuid())
  locationId String   @unique
  tenantId   String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("ghl_locations")
}

model Secuencia {
  id               String    @id @default(uuid())
  tenantId         String
  tipoECF          TipoECF
  prefijo          String
  ultimaSecuencia  Int       @default(0)
  fechaVencimiento DateTime?
  activo           Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, tipoECF])
  @@index([tenantId, activo])
  @@map("secuencias")
}

// ─── Finanzas ────────────────────────────────────────────────────────────────

// Movimiento manual de caja (nómina, alquiler, aporte de capital, impuestos…).
// No deriva de ningún documento fiscal.
model MovimientoFinanciero {
  id          String              @id @default(uuid())
  tenantId    String
  tipo        MovimientoTipo
  categoria   MovimientoCategoria
  monto       Decimal             @db.Decimal(18, 2)
  moneda      String              @default("DOP")
  fecha       DateTime
  descripcion String?
  metodoPago  String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, fecha])
  @@map("movimientos_financieros")
}

// Cobro (sobre una factura) o pago (sobre una compra). Es SÓLO una referencia
// contable: registrar un Pago NO modifica el estado DGII ni ningún campo del
// comprobante/compra. Soporta pagos parciales (varios Pago por documento).
model Pago {
  id            String   @id @default(uuid())
  tenantId      String
  tipo          PagoTipo
  comprobanteId String? // FK a la factura si es COBRO
  compraId      String? // FK a la compra si es PAGO
  monto         Decimal  @db.Decimal(18, 2)
  moneda        String   @default("DOP")
  fecha         DateTime
  metodoPago    String?
  createdAt     DateTime @default(now())

  tenant      Tenant          @relation(fields: [tenantId], references: [id])
  comprobante Comprobante?    @relation(fields: [comprobanteId], references: [id])
  compra      CompraRecibida? @relation(fields: [compraId], references: [id])

  @@index([tenantId, fecha])
  @@index([comprobanteId])
  @@index([compraId])
  @@map("pagos")
}

// Saldo de partida del negocio (uno por tenant). Punto de arranque del capital
// acumulado.
model CapitalInicial {
  id        String   @id @default(uuid())
  tenantId  String   @unique
  monto     Decimal  @db.Decimal(18, 2)
  moneda    String   @default("DOP")
  fecha     DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("capital_inicial")
}

// Apertura/cierre de caja física, un registro por tenant+día. NO fiscal: sólo
// control interno de efectivo (con cuánto abre el día, cuánto queda). El
// "esperado" al cerrar = montoApertura + neto COBRADO del día (pagos +
// movimientos manuales) — no distingue efectivo de tarjeta/transferencia
// (metodoPago es texto libre opcional, no confiable para filtrar).
model CajaDiaria {
  id            String     @id @default(uuid())
  tenantId      String
  fecha         DateTime   @db.Date
  estado        CajaEstado @default(ABIERTA)
  montoApertura Decimal    @db.Decimal(18, 2)
  notasApertura String?
  abiertaEn     DateTime   @default(now())
  montoEsperado Decimal?   @db.Decimal(18, 2)
  montoContado  Decimal?   @db.Decimal(18, 2)
  diferencia    Decimal?   @db.Decimal(18, 2)
  notasCierre   String?
  cerradaEn     DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, fecha])
  @@index([tenantId, estado])
  @@map("caja_diaria")
}

// Presupuesto/proyección de caja a 12 meses (NO fiscal, NO se toca desde el
// ciclo DGII). Un registro por tenant — se edita entero con un PUT, como
// CapitalInicial. `moneda` vive SOLO aquí: el motor fiscal es DOP-únicamente,
// esta columna nunca debe leerse fuera de este módulo. `ingresos`/`costosFijos`
// son listas simples que se reescriben completas (sin historial por línea) —
// ver PROPUESTA_PRESUPUESTO.md §3.1 para por qué JSON y no tablas relacionales.
model PresupuestoConfig {
  id              String   @id @default(uuid())
  tenantId        String   @unique
  sector          String?
  moneda          String   @default("DOP")
  mesFiscalInicio Int      @default(0) // 0=enero … 11=diciembre
  colchonMeses    Int      @default(3)
  metaMargenPct   Decimal  @db.Decimal(5, 2) @default(20)
  varPct          Decimal  @db.Decimal(5, 2) @default(0)
  cxcInicial      Decimal  @db.Decimal(18, 2) @default(0)
  cxpInicial      Decimal  @db.Decimal(18, 2) @default(0)
  ingresos        Json     @default("[]") // [{ nombre, montoMensual, crecimientoPct }]
  costosFijos     Json     @default("[]") // [{ nombre, categoria, montoMensual }]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("presupuesto_config")
}

// Registro de entregas de un comprobante al cliente a través de GoHighLevel
// (email hoy; WhatsApp en un sprint aparte). Es 100% POST-EMISIÓN y NO FISCAL:
// no toca el ecf-engine, no cambia el estado DGII del comprobante y no entra a
// los reportes 606/607/608.
//
// Va en tabla propia — no como columnas en `comprobantes` — por el mismo
// criterio ya aplicado en Finanzas con `Pago[]`: la tabla fiscal no se ensucia
// con estado no fiscal. Además la relación es 1:N real (reenvíos, dos canales,
// reintentos) y necesitamos resultado POR CANAL: WhatsApp puede fallar mientras
// el email sale bien, en la misma petición.
model EnvioComprobante {
  id                String      @id @default(uuid())
  tenantId          String
  comprobanteId     String
  canal             CanalEnvio
  estado            EstadoEnvio
  // Destino efectivamente usado (email o teléfono). Se guarda el valor real del
  // momento del envío: el contacto puede cambiar de correo después.
  destino           String?
  ghlMessageId      String?
  ghlConversationId String?
  // Agrupa las N filas que salieron en el MISMO correo (envío en lote). Un
  // correo con 5 facturas deja 5 filas —cada factura conserva su propio
  // "enviada el X"— unidas por este id. No se agrupa por `ghlMessageId`: es
  // nullable y no existe en las filas FALLIDO, que son las que más importa
  // poder leer juntas. Null en los envíos individuales.
  loteId            String?
  // Motivo cuando estado = FALLIDO. Se persiste el fallo, no sólo el éxito: un
  // envío que no salió tiene que ser visible y auditable.
  error             String?
  createdAt         DateTime    @default(now())

  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  comprobante Comprobante @relation(fields: [comprobanteId], references: [id])

  @@index([tenantId, comprobanteId])
  @@index([comprobanteId, createdAt])
  @@index([tenantId, loteId])
  @@map("envios_comprobante")
}
