generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Plan {
  BASICO
  PYME
  PRO
}

enum TenantEstado {
  ACTIVO
  SUSPENDIDO
  CANCELADO
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  USUARIO
  CONTADOR
}

enum TipoECF {
  E31
  E32
  E33
  E34
  E41
  E43
  E44
  E45
  E46
  E47
}

enum ComprobanteEstado {
  DRAFT
  PENDIENTE
  EN_COLA
  ENVIANDO
  ACEPTADO
  ACEPTADO_CONDICIONAL
  RECHAZADO
  ERROR
}

// ─── Models ───────────────────────────────────────────────────────────────────

model Tenant {
  id              String       @id @default(uuid())
  rnc             String       @unique
  razonSocial     String
  nombreComercial String?
  direccion       String?
  plan            Plan         @default(BASICO)
  estado          TenantEstado @default(ACTIVO)
  planActivo      Boolean      @default(true)
  trialEndsAt     DateTime?
  // Config GHL para sincronización de contactos (Sprint 3).
  // ghlAccessToken cifrado AES-256-GCM (formato iv:tag:data en base64).
  ghlAccessToken  String?
  ghlRncFieldKey  String?
  // Branding para la representación impresa (Sprint 6).
  logoUrl         String?
  colorPrimario   String?
  colorSecundario String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  users                User[]
  comprobantes         Comprobante[]
  certificados         Certificado[]
  apiKeys              ApiKey[]
  webhooks             Webhook[]
  auditLogs            AuditLog[]
  secuencias           Secuencia[]
  comprobantesRecibidos ComprobanteRecibido[]
  ghlLocations         GhlLocation[]
  productos            Producto[]
  contactos            Contacto[]
  cotizaciones         Cotizacion[]
  comprasRecibidas     CompraRecibida[]

  @@map("tenants")
}

model CompraRecibida {
  id                   String    @id @default(uuid())
  tenantId             String
  contactoId           String?   // proveedor (Contacto tipo PROVEEDOR)
  tipo                 String    // "E41" | "GASTO_MENOR" | "SIN_COMPROBANTE" | "RECIBIDO_ECF"
  ncf                  String?   // NCF/e-NCF del proveedor
  rncProveedor         String?
  razonSocialProveedor String?
  fechaComprobante     DateTime?
  subtotal             Decimal   @db.Decimal(18, 2)
  itbis                Decimal   @db.Decimal(18, 2)
  itbisRetenido        Decimal   @db.Decimal(18, 2) @default(0)
  total                Decimal   @db.Decimal(18, 2)
  estadoAprobacion     String?   // e-CF recibido: APROBADO|RECHAZADO|PENDIENTE
  origen               String    @default("MANUAL") // MANUAL|RECEPCION_DGII
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, fechaComprobante])
  @@map("compras_recibidas")
}

model Cotizacion {
  id            String   @id @default(uuid())
  tenantId      String
  folio         String   // interno, p.ej. COT-000123 (NO es e-NCF, nunca va a la DGII)
  contactoId    String?
  estado        String   @default("BORRADOR") // BORRADOR|ENVIADA|APROBADA|RECHAZADA|VENCIDA|CONVERTIDA
  fechaVigencia DateTime?
  subtotal      Decimal  @db.Decimal(18, 2)
  itbis         Decimal  @db.Decimal(18, 2)
  total         Decimal  @db.Decimal(18, 2)
  comprobanteId String?  // seteado al convertir
  notas         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant Tenant           @relation(fields: [tenantId], references: [id])
  items  CotizacionItem[]

  @@unique([tenantId, folio])
  @@index([tenantId, estado])
  @@map("cotizaciones")
}

model CotizacionItem {
  id               String   @id @default(uuid())
  cotizacionId     String
  productoId       String?
  nombre           String
  descripcion      String?
  cantidad             Decimal @db.Decimal(18, 3)
  precioUnitario       Decimal @db.Decimal(18, 2)
  tratamientoITBIS     String
  indicadorBienoServicio String @default("2") // "1"=Bien, "2"=Servicio
  unidadMedida         String?

  cotizacion Cotizacion @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)

  @@map("cotizacion_items")
}

// Contador atómico de folios por tenant (mismo patrón de incremento que las
// secuencias e-NCF). El INSERT ... ON CONFLICT DO NOTHING crea la fila sin
// condición de carrera y el UPDATE ... += 1 serializa por lock de fila.
model CotizacionFolio {
  tenantId    String   @id
  ultimoFolio Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@map("cotizacion_folios")
}

model Contacto {
  id                      String   @id @default(uuid())
  tenantId                String
  tipo                    String   // CLIENTE|PROVEEDOR|CONSUMIDOR_FINAL
  rnc                     String?
  razonSocial             String
  nombreComercial         String?
  identificadorExtranjero String?
  paisExtranjero          String?
  direccion               String?
  telefono                String?
  email                   String?
  origen                  String   @default("MANUAL") // MANUAL|GHL
  ghlContactId            String?
  rncValidado             Boolean  @default(false)
  activo                  Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, rnc])
  @@unique([tenantId, ghlContactId])
  @@index([tenantId, tipo, activo])
  @@map("contactos")
}

model Producto {
  id               String   @id @default(uuid())
  tenantId         String
  tipo             String   // "BIEN" | "SERVICIO"
  nombre           String
  descripcion      String?
  precioUnitario   Decimal  @db.Decimal(18, 2)
  tratamientoITBIS String   @default("I1") // I1|I2|I3|EXENTO
  unidadMedida     String?  // codificación DGII
  codigo           String?
  categoria        String?
  activo           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, codigo])
  @@index([tenantId, activo])
  @@map("productos")
}

model User {
  id                String   @id @default(uuid())
  tenantId          String
  email             String
  passwordHash      String
  nombre            String
  role              UserRole @default(USUARIO)
  activo                Boolean   @default(true)
  refreshTokenHash      String?
  resetPasswordToken    String?
  resetPasswordExpires  DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  auditLogs AuditLog[]

  @@unique([tenantId, email])
  @@map("users")
}

model Certificado {
  id                String   @id @default(uuid())
  tenantId          String
  // Metadatos del certificado (nunca el P12 en plano)
  titular           String
  rnc               String
  serial            String
  emitidoPor        String
  validoDesde       DateTime
  validoHasta       DateTime

  // P12 cifrado con AES-256-GCM (nunca se devuelve al cliente)
  p12Encrypted      String    // base64 del buffer cifrado
  p12Iv             String    // hex del IV
  p12Tag            String    // hex del auth tag GCM

  // Passphrase cifrada — formato base64(iv):base64(tag):base64(encrypted)
  passphraseCifrada String

  activo            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, activo])
  @@map("certificados")
}

model Comprobante {
  id           String            @id @default(uuid())
  tenantId     String
  // eNCF es nullable: los borradores (estado DRAFT) aún no consumen secuencia.
  // El e-NCF se asigna atómicamente sólo al emitir. NULLs son distintos en el
  // índice único de Postgres, así que múltiples borradores conviven sin colisión.
  eNCF         String?
  tipoECF      TipoECF
  estado       ComprobanteEstado @default(PENDIENTE)
  xmlFirmado   String?
  trackId      String?
  mensajeDGII  String?
  montoTotal   Decimal           @db.Decimal(18, 2)
  rnc          String            // RNC del comprador
  razonSocial  String            // Razón social del comprador
  pdfUrl       String?
  intentos     Int               @default(0)
  datos        Json?             // DTO original para el worker
  // Referencias (nullable). Las relaciones a Contacto/Cotizacion se agregan en
  // sprints posteriores; por ahora se persisten como columnas sueltas.
  contactoId              String?
  cotizacionId            String?
  comprobanteReferenciaId String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, eNCF])
  @@index([tenantId, estado])
  @@index([tenantId, createdAt])
  @@map("comprobantes")
}

model ApiKey {
  id        String    @id @default(uuid())
  tenantId  String
  nombre    String
  keyHash   String    @unique
  ultimoUso DateTime?
  activo    Boolean   @default(true)
  createdAt DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("api_keys")
}

model Webhook {
  id          String   @id @default(uuid())
  tenantId    String
  url         String
  secretoHMAC String
  eventos     String[]
  tipo        String   @default("SALIENTE") // "GHL_ENTRADA" | "SALIENTE"
  nombre      String?
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("webhooks")
}

model AuditLog {
  id        String   @id @default(uuid())
  tenantId  String
  userId    String?
  accion    String
  entidad   String
  entidadId String?
  detalle   Json?
  ip        String?
  createdAt DateTime @default(now())

  tenant Tenant  @relation(fields: [tenantId], references: [id])
  user   User?   @relation(fields: [userId], references: [id])

  @@index([tenantId, createdAt])
  @@index([tenantId, accion])
  @@map("audit_logs")
}

model ComprobanteRecibido {
  id             String   @id @default(uuid())
  tenantId       String   // tenant receptor (nuestro RNC)
  rncEmisor      String   // RNC del emisor que nos envía el e-CF
  eNCF           String   // número de e-CF
  tipoECF        String   // "31", "32", etc.
  xmlFirmado     String   // XML completo del e-CF recibido
  estado         String   @default("RECIBIDO") // RECIBIDO | ACEPTADO | RECHAZADO
  aprobacion     String?  // XML de aprobación comercial (ACECF)
  fechaRecepcion DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, eNCF, rncEmisor])
  @@index([tenantId, rncEmisor])
  @@index([tenantId, fechaRecepcion])
  @@map("comprobantes_recibidos")
}

model GhlLocation {
  id         String   @id @default(uuid())
  locationId String   @unique
  tenantId   String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("ghl_locations")
}

model Secuencia {
  id               String    @id @default(uuid())
  tenantId         String
  tipoECF          TipoECF
  prefijo          String
  ultimaSecuencia  Int       @default(0)
  fechaVencimiento DateTime?
  activo           Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, tipoECF])
  @@index([tenantId, activo])
  @@map("secuencias")
}
