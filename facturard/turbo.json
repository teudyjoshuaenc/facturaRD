{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "generate:api": {
      "dependsOn": ["api#build"],
      "outputs": ["packages/api-client/src/generated.ts"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "lint": {}
  }
}
