# Copiar a deploy/.env en el VPS (docker compose lo carga solo) y llenar. NUNCA se sube al repo.
# Generar secretos con: openssl rand -base64 48

# ── Dominios (DNS A → IP del VPS; deben coincidir con deploy/nginx/facturard.conf)
APP_DOMAIN=app.facturard.do
API_DOMAIN=api.facturard.do

# Puertos en 127.0.0.1 del host a los que apunta nginx (cambiar si ya están ocupados)
API_PORT=3000
WEB_PORT=3001

# ── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER=facturard
POSTGRES_PASSWORD=
POSTGRES_DB=facturard

# ── Redis ───────────────────────────────────────────────────────────────────
REDIS_PASSWORD=

# ── Auth ────────────────────────────────────────────────────────────────────
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ⚠️ ENCRYPTION_KEY cifra los P12, sus passphrases y los tokens de GHL. Instalación
# nueva: generar una (openssl rand -base64 48). Una vez que haya datos, NO cambiarla
# nunca ni perderla: con otra clave ningún tenant puede volver a firmar. Guardarla
# fuera del VPS (gestor de contraseñas). Sólo si se importan datos de otra instancia
# hay que usar la clave de esa instancia.
ENCRYPTION_KEY=

# ── Correo ──────────────────────────────────────────────────────────────────
SENDGRID_API_KEY=
SENDGRID_FROM=noreply@facturard.do

# ── Cloudinary (obligatorio: sin esto la API no arranca) ────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── DGII ────────────────────────────────────────────────────────────────────
# Cualquier valor distinto de "production" = ambiente de certificación (certecf).
DGII_ENV=certification

# ── Frontend (se incrusta en el build: cambiar exige --build) ────────────────
NEXT_PUBLIC_SHOW_WIP_TABS=

# ── Backups (deploy/backup.sh) ──────────────────────────────────────────────
BACKUP_DIR=/var/backups/facturard
BACKUP_RETENTION_DAYS=30
